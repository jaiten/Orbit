{
  "name": "orbit-desktop",
  "version": "0.2.0",
  "private": true,
  "description": "A little space for what matters.",
  "author": "Orbit",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:desktop": "node tests/desktop-smoke.cjs",
    "pack": "electron-builder --win portable"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "playwright": "1.64.1"
  },
  "build": {
    "appId": "com.orbit.planner",
    "productName": "Orbit",
    "directories": {
      "output": "dist"
    },
    "files": [
      "*.cjs",
      "ui/**",
      "assets/**",
      "config.json"
    ],
    "win": {
      "target": "portable",
      "icon": "assets/orbit.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "Orbit-${version}.exe"
    }
  }
}
