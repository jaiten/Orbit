{
  "name": "orbit-desktop",
  "version": "0.3.10",
  "private": true,
  "description": "A simple planner for today, synced with iPhone.",
  "author": "Orbit",
  "repository": {
    "type": "git",
    "url": "https://github.com/jaiten/Orbit.git",
    "directory": "windows"
  },
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:desktop": "node tests/desktop-smoke.cjs",
    "test:refinements": "node tests/refinement-smoke.cjs",
    "pack": "electron-builder --win nsis portable --publish never",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "generate": "node scripts/generate.cjs",
    "test:installer": "node tests/installer-smoke.cjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "electron": "44.9.3",
    "electron-builder": "26.15.3",
    "eslint": "9.39.1",
    "globals": "16.5.0",
    "js-yaml": "4.3.2",
    "playwright": "1.64.1",
    "prettier": "3.3.3"
  },
  "overrides": {
    "fast-uri": "3.1.9"
  },
  "build": {
    "appId": "com.orbit.planner",
    "productName": "Orbit",
    "directories": {
      "output": "dist"
    },
    "files": [
      "*.cjs",
      "ui/**",
      "assets/**",
      "config.json"
    ],
    "publish": {
      "provider": "github",
      "owner": "jaiten",
      "repo": "Orbit",
      "releaseType": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/orbit.ico"
    },
    "portable": {
      "artifactName": "Orbit-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Orbit",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Orbit-Setup-${version}.exe"
    }
  }
}
